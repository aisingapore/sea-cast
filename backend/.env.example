# SEA-CAST backend configuration — copy to `.env` and fill in.
# `.env` is gitignored; this template is committed.

SEA_CAST_CONFIG=sea-cast.yaml

# ── Server ────────────────────────────────────────────────────────────────────
# CORS_ORIGINS=["http://localhost:5173"]

# ── Session ──────────────────────────────────────────────────────────────────
# Admin auth for the /history page — set BOTH to enable, or leave unset
ADMIN_USERNAME=
ADMIN_PASSWORD=
# RECORDINGS_DIR=./recordings

# ── STT Settings / Auth ──────────────────────────────────────────────────────
# VAD_START_SECS=0.2
# VAD_STOP_SECS=0.7
# VAD_CONFIDENCE=0.7         # Raise if coughs/chatter get transcribed    

# STT_MAX_SEGMENT_SECS=8     # set to 0 to disable, remove for default 8.0s

# Add API keys for STT profiles here.
ELEVENLABS_API_KEY=

# ── Translation Settings / Auth ──────────────────────────────────────────────
# Add API keys for translator profiles here.
SEALION_KEY=
# ROLLING_WINDOW_N=4         # prior utterances carried for coherence